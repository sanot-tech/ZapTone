# 🧠 Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 📦 build output
build/
dist/
*.spec.bak
*.onefile
__pypackages__/

# 🐧 AppImage build
AppDir/
*.AppImage
.zsync
appimage-builder.yml
squashfs-root/

# 🖼️ Generated PNG sizes (they come from assets/icon.svg with
#    scripts/make_icons.py, so we do not keep every size in git).
assets/icons/*.png

# ⚠️ The .ico IS committed on purpose: PyInstaller on Windows cannot
#    render SVG, and Windows runners have no librsvg. Committing one
#    90 KB file is much better than shipping no icon at all.
!assets/icons/ZapTone.ico
*.icns

# 🖼️ brand and screenshots are real project files, keep them
!assets/brand/*
!assets/screenshots/*.png

# 🎬 user media and test output
*.mp3
*.m4a
*.tmp
zaptone-test-*/

# 🗒️ logs and editor files
*.log
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# 🤖 secrets - never commit these
.env
*.token
credentials.json